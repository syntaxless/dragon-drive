<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Simulator builds only (CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*]). Phone and TestFlight builds don't
	     carry it until Apple grants the CarPlay Driving Task entitlement: a profile without it would fail to sign. -->
	<key>com.apple.developer.carplay-driving-task</key>
	<true/>
</dict>
</plist>
